{
  "uid": "tributary-github",
  "title": "GitHub: commits and hosted minutes",
  "description": "From Tributary's github connector (DevStats): who wrote the commits on the default branches (you alone, you with an agent, a bot, someone else), the workflow runs and how long they took, and GitHub-hosted runner minutes against the 2,000 a free plan includes each month.",
  "tags": [
    "tributary",
    "github"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-6M",
    "to": "now"
  },
  "links": [],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "dev",
        "label": "InfluxDB DevStats",
        "query": "influxdb",
        "regex": "/DevStats/i",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "type": "textbox",
        "name": "tz",
        "label": "Time zone",
        "description": "IANA time zone the days and weeks are cut in (TRIBUTARY_TZ).",
        "query": "Europe/Paris",
        "current": {
          "text": "Europe/Paris",
          "value": "Europe/Paris"
        },
        "options": [
          {
            "selected": true,
            "text": "Europe/Paris",
            "value": "Europe/Paris"
          }
        ],
        "hide": 0
      },
      {
        "name": "owner",
        "label": "Account",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${dev}"
        },
        "query": "SHOW TAG VALUES FROM \"github_commit\" WITH KEY = \"owner\"",
        "definition": "SHOW TAG VALUES FROM \"github_commit\" WITH KEY = \"owner\"",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "name": "billed",
        "label": "Billed account",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${dev}"
        },
        "query": "SHOW TAG VALUES FROM \"github_actions_month\" WITH KEY = \"owner\" WHERE \"owner\" =~ /^${owner:regex}$/",
        "definition": "SHOW TAG VALUES FROM \"github_actions_month\" WITH KEY = \"owner\" WHERE \"owner\" =~ /^${owner:regex}$/",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1,
        "hide": 2,
        "options": [],
        "regex": ""
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Hosted minutes (GitHub's billing report)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "id": 2,
      "title": "Included minutes used this month",
      "description": "What counts against the plan's 2,000 included minutes this month, per account: the private repositories' standard GitHub-hosted runners (Windows twice, macOS ten times). Public repositories and self-hosted (ARC) runners are free. Yellow from 80%, red at 2,000. From Tributary's github connector (github_actions_month), read daily.",
      "datasource": {
        "type": "influxdb",
        "uid": "${dev}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 4
      },
      "timeFrom": "now/M",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${dev}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"counted_minutes\") FROM \"github_actions_month\" WHERE $timeFilter AND \"owner\" =~ /^${owner:regex}$/ GROUP BY \"owner\"",
          "alias": "$tag_owner"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2000,
          "decimals": 0,
          "unit": "suffix: min",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1600
              },
              {
                "color": "#d03b3b",
                "value": 2000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "text",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 24,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Included minutes per month: $billed",
      "description": "Each month's minutes counted against the 2,000 included ones (dashed line), the last 12 months whatever the dashboard's range. The current month is the month so far.",
      "datasource": {
        "type": "influxdb",
        "uid": "${dev}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "timeFrom": "1y",
      "repeat": "billed",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${dev}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT \"counted_minutes\" FROM \"github_actions_month\" WHERE $timeFilter AND \"owner\" = '${billed}'",
          "alias": "Counted minutes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "suffix: min",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "fillOpacity": 100,
            "lineWidth": 0,
            "showPoints": "never",
            "axisSoftMax": 2200,
            "axisBorderShow": false,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 2000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "type": "table",
      "id": 4,
      "title": "Hosted minutes by repository",
      "description": "GitHub-hosted minutes over the dashboard's range, per repository, as billed (before the Windows and macOS multipliers). Only private repositories' count against the included minutes; a repository deleted since counts as private.",
      "datasource": {
        "type": "influxdb",
        "uid": "${dev}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${dev}"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT sum(\"minutes\") AS \"Minutes\", last(\"private\") AS \"Private\" FROM \"github_actions_usage\" WHERE $timeFilter AND \"owner\" =~ /^${owner:regex}$/ GROUP BY \"owner\", \"repository\""
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "owner": "Account",
              "repository": "Repository"
            },
            "indexByName": {
              "repository": 0,
              "owner": 1,
              "Minutes": 2,
              "Private": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Minutes",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Minutes"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "unit",
                "value": "suffix: min"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Private"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "private: counts",
                        "index": 0
                      },
                      "false": {
                        "text": "public: free",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Minutes"
          ]
        }
      }
    },
    {
      "type": "table",
      "id": 10,
      "title": "Last 50 workflow runs",
      "description": "The 50 latest runs of the selected accounts' repositories, 10 a page, whatever the dashboard's range. Every run is listed, self-hosted (ARC) ones included: the billing report says which repositories hosted minutes were billed to. Duration is run_started_at to updated_at; a re-run replaces its first attempt.",
      "datasource": {
        "type": "influxdb",
        "uid": "${dev}"
      },
      "timeFrom": "2y",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 14,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${dev}"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT \"duration_s\", \"result\", \"attempts\" FROM \"github_workflow_run\" WHERE $timeFilter AND \"owner\" =~ /^${owner:regex}$/ ORDER BY time DESC LIMIT 50"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Time",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "limit",
          "options": {
            "limitField": 50
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "owner": true,
              "event": true,
              "visibility": true,
              "succeeded": true,
              "failed": true,
              "cancelled": true,
              "count": true
            },
            "renameByName": {
              "duration_s": "Duration",
              "result": "Result",
              "attempts": "Attempts",
              "repository": "Repository",
              "workflow": "Workflow"
            },
            "indexByName": {
              "Time": 0,
              "Repository": 1,
              "Workflow": 2,
              "Result": 3,
              "Duration": 4,
              "Attempts": 5
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Attempts"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Result"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "other",
                        "index": 0
                      },
                      "1": {
                        "text": "success",
                        "index": 1,
                        "color": "#0ca30c"
                      },
                      "2": {
                        "text": "failed",
                        "index": 2,
                        "color": "#d03b3b"
                      },
                      "3": {
                        "text": "cancelled",
                        "index": 3,
                        "color": "#fab219"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Repository"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": true,
        "pageSize": 10
      }
    },
    {
      "type": "table",
      "id": 11,
      "title": "Longest runs in the selected period",
      "description": "The 20 longest runs created over the dashboard's range, by duration (run_started_at to updated_at). Every run is listed, self-hosted (ARC) ones included.",
      "datasource": {
        "type": "influxdb",
        "uid": "${dev}"
      },
      "gridPos": {
        "x": 14,
        "y": 23,
        "w": 10,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${dev}"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT TOP(\"duration_s\", \"repository\", \"workflow\", \"event\", 20) FROM \"github_workflow_run\" WHERE $timeFilter AND \"owner\" =~ /^${owner:regex}$/"
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "top",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "top": "Duration",
              "repository": "Repository",
              "workflow": "Workflow",
              "event": "Event"
            },
            "indexByName": {
              "Time": 0,
              "Repository": 1,
              "Workflow": 2,
              "Event": 3,
              "Duration": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Repository"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Event"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": true,
        "pageSize": 10
      }
    },
    {
      "type": "row",
      "title": "Commits (default branches, merges left out)",
      "id": 5,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Commits by author",
      "description": "Commits of the selected accounts' default branches over the range. agent: an agent (Claude, Copilot, OpenHands) wrote it or co-authored it; bot: Renovate, GitHub Actions...; self: you alone; other: anyone else, and emails not on your GitHub account.",
      "datasource": {
        "type": "influxdb",
        "uid": "${dev}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 16,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${dev}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"count\") FROM \"github_commit\" WHERE $timeFilter AND \"owner\" =~ /^${owner:regex}$/ AND \"author\" = 'self'",
          "alias": "self"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "${dev}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"count\") FROM \"github_commit\" WHERE $timeFilter AND \"owner\" =~ /^${owner:regex}$/ AND \"author\" = 'agent'",
          "alias": "agent"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "influxdb",
            "uid": "${dev}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"count\") FROM \"github_commit\" WHERE $timeFilter AND \"owner\" =~ /^${owner:regex}$/ AND \"author\" = 'bot'",
          "alias": "bot"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "influxdb",
            "uid": "${dev}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"count\") FROM \"github_commit\" WHERE $timeFilter AND \"owner\" =~ /^${owner:regex}$/ AND \"author\" = 'other'",
          "alias": "other"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Of your commits, made with an agent",
      "description": "agent / (agent + self): the share of the commits you made that an agent wrote or co-wrote. Bots and others left out.",
      "datasource": {
        "type": "influxdb",
        "uid": "${dev}"
      },
      "gridPos": {
        "x": 16,
        "y": 36,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${dev}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"count\") FROM \"github_commit\" WHERE $timeFilter AND \"owner\" =~ /^${owner:regex}$/ AND \"author\" = 'agent'",
          "hide": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "${dev}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"count\") FROM \"github_commit\" WHERE $timeFilter AND \"owner\" =~ /^${owner:regex}$/ AND \"author\" = 'self'",
          "hide": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "$A / ($A + $B) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Commits per week, by author",
      "description": "Monday-to-Sunday weeks (UTC), stacked: self, agent, bot, other.",
      "datasource": {
        "type": "influxdb",
        "uid": "${dev}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${dev}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"count\") FROM \"github_commit\" WHERE $timeFilter AND \"owner\" =~ /^${owner:regex}$/ AND \"author\" = 'self' GROUP BY time(1w, -3d) fill(0) tz('$tz')",
          "alias": "self"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "${dev}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"count\") FROM \"github_commit\" WHERE $timeFilter AND \"owner\" =~ /^${owner:regex}$/ AND \"author\" = 'agent' GROUP BY time(1w, -3d) fill(0) tz('$tz')",
          "alias": "agent"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "influxdb",
            "uid": "${dev}"
          },
