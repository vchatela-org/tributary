{
  "uid": "tributary-correlations",
  "title": "Correlations",
  "description": "One domain against another, paired per day, per evening and the night after, or per week: sleep and HRV against the tasks done, evening reading against the night, training against recovery. Each side reads one source you pick.",
  "tags": [
    "tributary",
    "overview",
    "sleep",
    "productivity"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "refresh": "",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "Healthspan",
      "url": "/d/tributary-healthspan",
      "icon": "dashboard",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "tooltip": "",
      "tags": []
    },
    {
      "type": "link",
      "title": "Sleep",
      "url": "/d/tributary-sleep",
      "icon": "dashboard",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "tooltip": "",
      "tags": []
    },
    {
      "type": "link",
      "title": "Todoist",
      "url": "/d/tributary-todoist",
      "icon": "dashboard",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "tooltip": "",
      "tags": []
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "garmin",
        "label": "InfluxDB GarminStats",
        "query": "influxdb",
        "regex": "/GarminStats/i",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "type": "datasource",
        "name": "sleep",
        "label": "InfluxDB SleepStats",
        "query": "influxdb",
        "regex": "/SleepStats/i",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "type": "datasource",
        "name": "body",
        "label": "InfluxDB BodyStats",
        "query": "influxdb",
        "regex": "/BodyStats/i",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "type": "datasource",
        "name": "todoist",
        "label": "InfluxDB TodoistStats",
        "query": "influxdb",
        "regex": "/TodoistStats/i",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "type": "datasource",
        "name": "media",
        "label": "InfluxDB MediaStats",
        "query": "influxdb",
        "regex": "/MediaStats/i",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "type": "textbox",
        "name": "tz",
        "label": "Time zone",
        "description": "IANA time zone the days and weeks are cut in (TRIBUTARY_TZ).",
        "query": "Europe/Paris",
        "current": {
          "text": "Europe/Paris",
          "value": "Europe/Paris"
        },
        "options": [
          {
            "selected": true,
            "text": "Europe/Paris",
            "value": "Europe/Paris"
          }
        ],
        "hide": 0
      },
      {
        "type": "query",
        "name": "user",
        "label": "User",
        "description": "The person: the user tag of BodyStats and SleepStats (GarminStats holds one person and has none).",
        "datasource": {
          "type": "influxdb",
          "uid": "${body}"
        },
        "definition": "SHOW TAG VALUES WITH KEY = \"user\"",
        "query": "SHOW TAG VALUES WITH KEY = \"user\"",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "current": {},
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "type": "query",
        "name": "nights",
        "label": "Night sources",
        "description": "Every source of nights in SleepStats, for the Sleep from and Heart from lists.",
        "datasource": {
          "type": "influxdb",
          "uid": "${sleep}"
        },
        "definition": "SHOW TAG VALUES FROM \"sleep_session\" WITH KEY = \"source\" WHERE \"user\" = '$user'",
        "query": "SHOW TAG VALUES FROM \"sleep_session\" WITH KEY = \"source\" WHERE \"user\" = '$user'",
        "refresh": 1,
        "sort": 1,
        "hide": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "multi": true,
        "includeAll": true
      },
      {
        "type": "query",
        "name": "days",
        "label": "Daily activity sources",
        "description": "Every source of daily totals (steps, strain) in BodyStats.",
        "datasource": {
          "type": "influxdb",
          "uid": "${body}"
        },
        "definition": "SHOW TAG VALUES FROM \"daily_activity\" WITH KEY = \"source\" WHERE \"user\" = '$user'",
        "query": "SHOW TAG VALUES FROM \"daily_activity\" WITH KEY = \"source\" WHERE \"user\" = '$user'",
        "refresh": 1,
        "sort": 1,
        "hide": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "multi": true,
        "includeAll": true
      },
      {
        "type": "query",
        "name": "workouts",
        "label": "Workout sources",
        "description": "The sources of workouts in BodyStats that write no daily total.",
        "datasource": {
          "type": "influxdb",
          "uid": "${body}"
        },
        "definition": "SHOW TAG VALUES FROM \"exercise\" WITH KEY = \"source\" WHERE \"user\" = '$user'",
        "query": "SHOW TAG VALUES FROM \"exercise\" WITH KEY = \"source\" WHERE \"user\" = '$user'",
        "refresh": 1,
        "sort": 1,
        "hide": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "multi": true,
        "includeAll": true,
        "regex": "/^(?!(?:${days:pipe})$).*$/"
      },
      {
        "type": "custom",
        "name": "sleep_from",
        "label": "Sleep from",
        "description": "The source of the time asleep.",
        "query": "${nights:csv},garmin",
        "hide": 0,
        "current": {},
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "type": "custom",
        "name": "heart_from",
        "label": "Heart from",
        "description": "The source of the HRV.",
        "query": "${nights:csv},garmin",
        "hide": 0,
        "current": {},
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "type": "custom",
        "name": "activity_from",
        "label": "Workouts from",
        "description": "The source of the workouts.",
        "query": "${days:csv},garmin,${workouts:csv}",
        "hide": 0,
        "current": {},
        "options": [],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "A night and the day it ends",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "xychart",
      "pluginVersion": "13.2.3",
      "title": "Time asleep and the tasks done that day",
      "id": 2,
      "description": "Each point is a day: the night that ended that morning (from Sleep from) against the Todoist tasks completed that day. A cloud rising to the right means longer nights, more done.",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 9,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "show": "points",
            "pointSize": {
              "fixed": 7
            },
            "pointShape": "circle",
            "pointStrokeWidth": 1,
            "fillOpacity": 45,
            "axisPlacement": "auto",
            "axisBorderShow": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "asleep"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "Time asleep"
              },
              {
                "id": "unit",
                "value": "suffix: h"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tasks"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "Tasks completed"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "mapping": "manual",
        "series": [
          {
            "frame": {
              "matcher": {
                "id": "byIndex",
                "options": 0
              }
            },
            "x": {
              "matcher": {
                "id": "byName",
                "options": "asleep"
              }
            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "tasks"
              }
            }
          }
        ],
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "S",
          "datasource": {
            "type": "influxdb",
            "uid": "${garmin}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"sleepTimeSeconds\") / 3600 FROM \"SleepSummary\" WHERE 'garmin' = '${sleep_from}' AND $timeFilter GROUP BY time(1d) fill(none) tz('$tz')",
          "alias": "asleep"
        },
        {
          "refId": "T",
          "datasource": {
            "type": "influxdb",
            "uid": "${sleep}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"asleep_s\") / 3600 FROM \"sleep_session\" WHERE \"source\" = '${sleep_from}' AND \"user\" = '$user' AND \"kind\" != 'nap' AND $timeFilter GROUP BY time(1d) fill(none) tz('$tz')",
          "alias": "asleep"
        },
        {
          "refId": "K",
          "datasource": {
            "type": "influxdb",
            "uid": "${todoist}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"count\") FROM \"todoist_completion\" WHERE $timeFilter GROUP BY time(1d) fill(0) tz('$tz')",
          "alias": "tasks"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "inner"
          }
        }
      ]
    },
