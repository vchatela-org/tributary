{
  "uid": "tributary-habits",
  "title": "Habits & recovery",
  "tags": [
    "tributary"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "description": "A daily journal (yes or no questions, from any journal) against the night that follows each day, its recovery, HRV and sleep read from the sources picked for each.",
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "garmin",
        "label": "InfluxDB GarminStats",
        "query": "influxdb",
        "regex": "/GarminStats/i",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "type": "datasource",
        "name": "sleep",
        "label": "InfluxDB SleepStats",
        "query": "influxdb",
        "regex": "/SleepStats/i",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "type": "textbox",
        "name": "tz",
        "label": "Time zone",
        "description": "IANA time zone the days and weeks are cut in (TRIBUTARY_TZ).",
        "query": "Europe/Paris",
        "current": {
          "text": "Europe/Paris",
          "value": "Europe/Paris"
        },
        "options": [
          {
            "selected": true,
            "text": "Europe/Paris",
            "value": "Europe/Paris"
          }
        ],
        "hide": 0
      },
      {
        "type": "query",
        "name": "user",
        "label": "User",
        "description": "Whose journal: the user tag of SleepStats.",
        "datasource": {
          "type": "influxdb",
          "uid": "${sleep}"
        },
        "definition": "SHOW TAG VALUES FROM \"journal\" WITH KEY = \"user\"",
        "query": "SHOW TAG VALUES FROM \"journal\" WITH KEY = \"user\"",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "current": {},
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "type": "query",
        "name": "source",
        "label": "Source",
        "description": "The journals to read.",
        "datasource": {
          "type": "influxdb",
          "uid": "${sleep}"
        },
        "definition": "SHOW TAG VALUES FROM \"journal\" WITH KEY = \"source\" WHERE \"user\" = '$user'",
        "query": "SHOW TAG VALUES FROM \"journal\" WITH KEY = \"source\" WHERE \"user\" = '$user'",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "multi": true,
        "includeAll": true
      },
      {
        "type": "query",
        "name": "question",
        "label": "Question",
        "description": "The question the One question row reads.",
        "datasource": {
          "type": "influxdb",
          "uid": "${sleep}"
        },
        "definition": "SHOW TAG VALUES FROM \"journal\" WITH KEY = \"question\" WHERE \"user\" = '$user'",
        "query": "SHOW TAG VALUES FROM \"journal\" WITH KEY = \"question\" WHERE \"user\" = '$user'",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "current": {},
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "type": "query",
        "name": "nights",
        "label": "Night sources",
        "description": "Every source of nights in SleepStats, for the night pickers.",
        "datasource": {
          "type": "influxdb",
          "uid": "${sleep}"
        },
        "definition": "SHOW TAG VALUES FROM \"sleep_session\" WITH KEY = \"source\" WHERE \"user\" = '$user'",
        "query": "SHOW TAG VALUES FROM \"sleep_session\" WITH KEY = \"source\" WHERE \"user\" = '$user'",
        "refresh": 1,
        "sort": 1,
        "hide": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "multi": true,
        "includeAll": true
      },
      {
        "type": "custom",
        "name": "recovery_from",
        "label": "Recovery from",
        "description": "The source of the morning's recovery score.",
        "query": "${nights:csv}",
        "hide": 0,
        "current": {},
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "type": "custom",
        "name": "hrv_from",
        "label": "HRV from",
        "description": "The source of the overnight HRV. Devices measure it differently.",
        "query": "${nights:csv},garmin",
        "hide": 0,
        "current": {},
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "type": "custom",
        "name": "sleep_from",
        "label": "Sleep from",
        "description": "The source of the time asleep.",
        "query": "${nights:csv},garmin",
        "hide": 0,
        "current": {},
        "options": [],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "Sleep",
