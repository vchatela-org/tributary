  "panels": [
    {
      "type": "row",
      "title": "Every question",
      "id": 7,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "Journal calendar",
      "type": "state-timeline",
      "datasource": {
        "type": "influxdb",
        "uid": "${sleep}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${sleep}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT max(\"answered_yes\") FROM \"journal\" WHERE \"source\" =~ /^${source:regex}$/ AND \"user\" = '$user' AND $timeFilter GROUP BY time(1d), \"question\" fill(none) tz('$tz')",
          "alias": "$tag_question"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 1,
            "insertNulls": 129600000,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Yes",
                  "color": "blue",
                  "index": 0
                },
                "0": {
                  "text": "No",
                  "color": "#3b3f4a",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3b3f4a",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": false,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "One row per journal question, one cell per day: blue is yes, dark is no, blank is not answered. The colours are neutral on purpose: yes is not always the good answer."
    },
    {
      "id": 2,
      "title": "Yes rate per question",
      "type": "bargauge",
      "datasource": {
        "type": "influxdb",
        "uid": "${sleep}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${sleep}"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT mean(\"answered_yes\") AS \"Yes rate\" FROM \"journal\" WHERE \"source\" =~ /^${source:regex}$/ AND \"user\" = '$user' AND $timeFilter GROUP BY \"question\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Yes rate$/",
          "values": true
        },
        "namePlacement": "left",
        "text": {
          "valueSize": 16,
          "titleSize": 13
        },
        "sizing": "auto",
        "minVizHeight": 14,
        "maxVizHeight": 24
      },
      "description": "The share of the days a question was answered on which the answer was yes."
    },
    {
      "id": 3,
      "title": "The night after a yes or a no",
      "type": "table",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${sleep}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT max(\"answered_yes\") FROM \"journal\" WHERE \"source\" =~ /^${source:regex}$/ AND \"user\" = '$user' AND $timeFilter GROUP BY time(1d, -12h), \"question\" fill(none) tz('$tz')",
          "alias": "answer"
        },
        {
          "refId": "R",
          "datasource": {
            "type": "influxdb",
            "uid": "${sleep}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"recovery_score\") FROM \"sleep_session\" WHERE \"source\" = '${recovery_from}' AND \"user\" = '$user' AND \"kind\" != 'nap' AND $timeFilter GROUP BY time(1d, -12h) fill(none) tz('$tz')",
          "alias": "recovery"
        },
        {
          "refId": "H",
          "datasource": {
            "type": "influxdb",
            "uid": "${garmin}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"avgOvernightHrv\") FROM \"SleepSummary\" WHERE \"sleepTimeSeconds\" > 0 AND \"remSleepSeconds\" > 0 AND 'garmin' = '${hrv_from}' AND $timeFilter GROUP BY time(1d, -12h) fill(none) tz('$tz')",
          "alias": "hrv"
        },
        {
          "refId": "I",
          "datasource": {
            "type": "influxdb",
            "uid": "${sleep}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"hrv_rmssd_ms\") FROM \"sleep_session\" WHERE \"source\" = '${hrv_from}' AND \"user\" = '$user' AND \"kind\" != 'nap' AND $timeFilter GROUP BY time(1d, -12h) fill(none) tz('$tz')",
          "alias": "hrv"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "custom": {
            "align": "auto",
            "minWidth": 80,
            "wrapHeaderText": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Question"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Δ.*"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": -1
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*days"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "For each question, the night after the days answered yes against the night after the days answered no: the next morning's recovery and the night's HRV, from the sources picked in Recovery from and HRV from, whichever journal the answers come from. A day runs noon to noon, so an answer meets the night that ends the next morning. Days counts the days answered; one without a night in the picked source counts there, not in the averages. Few yes or no days make the difference noise; this is correlation, not cause.",
      "transformations": [
        {
          "id": "labelsToFields",
          "filter": {
            "id": "byRefId",
            "options": "A"
          },
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "filter": {
            "id": "byRefId",
            "options": "A"
          },
          "options": {}
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^(.* )?question$",
            "renamePattern": "question"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^(Value|answer)$",
            "renamePattern": "answer"
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "question",
                "config": {
                  "id": "isNotNull",
                  "options": {}
                }
              }
            ]
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "question": {
                "operation": "groupby",
                "aggregations": []
              },
              "answer": {
                "operation": "groupby",
                "aggregations": []
              },
              "Time": {
                "operation": "aggregate",
                "aggregations": [
                  "count"
                ]
              },
              "recovery": {
                "operation": "aggregate",
                "aggregations": [
                  "mean"
                ]
              },
              "hrv": {
                "operation": "aggregate",
                "aggregations": [
                  "mean"
                ]
              },
              "asleep": {
                "operation": "aggregate",
                "aggregations": [
                  "mean"
                ]
              }
            }
          }
        },
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "answer"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": true
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "question",
            "mode": "outer"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "Δ recovery",
            "replaceFields": false,
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "recovery (mean) 1"
                }
              },
              "operator": "-",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "recovery (mean) 0"
                }
              }
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "Δ HRV",
            "replaceFields": false,
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "hrv (mean) 1"
                }
              },
              "operator": "-",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "hrv (mean) 0"
                }
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "Time (count) 1": "Yes days",
              "Time (count) 0": "No days",
              "recovery (mean) 1": "Recovery if yes",
              "recovery (mean) 0": "Recovery if no",
              "hrv (mean) 1": "HRV if yes",
              "hrv (mean) 0": "HRV if no",
              "question 0": "Question",
              "question 1": "Question"
            },
            "indexByName": {
              "question 0": 0,
              "question 1": 0,
              "Time (count) 1": 1,
              "Time (count) 0": 2,
              "recovery (mean) 1": 3,
              "recovery (mean) 0": 4,
              "Δ recovery": 5,
              "hrv (mean) 1": 6,
              "hrv (mean) 0": 7,
              "Δ HRV": 8
            }
          }
        }
      ]
    },
