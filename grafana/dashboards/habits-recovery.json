          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"answered_yes\") FROM \"journal\" WHERE \"source\" =~ /^${source:regex}$/ AND \"user\" = '$user' AND \"question\" = '${question}' AND \"asleep_s\" < 23400 AND $timeFilter",
          "alias": "Slept under 6.5 h"
