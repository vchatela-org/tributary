          "query": "SELECT mean(\"answered_yes\") FROM \"journal\" WHERE \"source\" =~ /^${source:regex}$/ AND \"user\" = '$user' AND \"question\" = '${question}' AND \"recovery_score\" >= 50 AND $timeFilter",
          "alias": "Recovery 50 or more"
        },
        {
          "refId": "F4",
