      "keepTime": true,
      "targetBlank": false,
      "tooltip": "",
      "tags": []
    },
    {
      "type": "link",
      "title": "Correlations",
      "url": "/d/tributary-correlations",
      "icon": "dashboard",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "tooltip": "",
      "tags": []
    }
