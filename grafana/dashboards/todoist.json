{
  "uid": "tributary-todoist",
  "title": "Todoist",
  "description": "Completed Todoist tasks in InfluxDB TodoistStats: completions per day and project, due dates, priority, streak and karma.",
  "tags": [
    "tributary",
    "productivity"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "todoist",
        "label": "InfluxDB TodoistStats",
        "query": "influxdb",
        "regex": "/TodoistStats/i",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "type": "datasource",
        "name": "garmin",
        "label": "InfluxDB GarminStats",
        "query": "influxdb",
        "regex": "/GarminStats/i",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "type": "datasource",
        "name": "sleep",
        "label": "InfluxDB SleepStats",
        "query": "influxdb",
        "regex": "/SleepStats/i",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "type": "textbox",
        "name": "tz",
        "label": "Time zone",
        "description": "IANA time zone the days and weeks are cut in (TRIBUTARY_TZ).",
        "query": "Europe/Paris",
        "current": {
          "text": "Europe/Paris",
          "value": "Europe/Paris"
        },
        "options": [
          {
            "selected": true,
            "text": "Europe/Paris",
            "value": "Europe/Paris"
          }
        ],
        "hide": 0
      },
      {
        "type": "query",
        "name": "project",
        "label": "Project",
        "datasource": {
          "type": "influxdb",
          "uid": "${todoist}"
        },
        "definition": "SHOW TAG VALUES FROM \"todoist_completion\" WITH KEY = \"project\"",
        "query": "SHOW TAG VALUES FROM \"todoist_completion\" WITH KEY = \"project\"",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "current": {},
        "options": [],
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "type": "query",
        "name": "user",
        "label": "User",
        "description": "Whose nights the recovery row draws: the user tag of SleepStats (TodoistStats and GarminStats hold one person and have none).",
        "datasource": {
          "type": "influxdb",
          "uid": "${sleep}"
        },
        "definition": "SHOW TAG VALUES FROM \"sleep_session\" WITH KEY = \"user\"",
        "query": "SHOW TAG VALUES FROM \"sleep_session\" WITH KEY = \"user\"",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "current": {},
        "options": [],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Completions",
      "datasource": {
        "type": "influxdb",
        "uid": "${todoist}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${todoist}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"count\") FROM \"todoist_completion\" WHERE $timeFilter AND \"project\" =~ /^${project:regex}$/"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Every completion in the range, recurring tasks included."
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Tasks per day",
      "datasource": {
        "type": "influxdb",
        "uid": "${todoist}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${todoist}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"n\") FROM (SELECT sum(\"count\") AS \"n\" FROM \"todoist_completion\" WHERE $timeFilter AND \"project\" =~ /^${project:regex}$/ GROUP BY time(1d) fill(0) tz('$tz'))"
        }
      ],
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Average over every day of the range, days with nothing done included."
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Active days",
      "datasource": {
        "type": "influxdb",
        "uid": "${todoist}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${todoist}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT 100 * mean(\"a\") FROM (SELECT ceil(sum(\"count\") / (sum(\"count\") + 1)) AS \"a\" FROM \"todoist_completion\" WHERE $timeFilter AND \"project\" =~ /^${project:regex}$/ GROUP BY time(1d) fill(0) tz('$tz'))"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Share of days with at least one completion."
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Daily streak (now)",
      "datasource": {
        "type": "influxdb",
        "uid": "${todoist}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${todoist}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"current_daily_streak\") AS \"Current\", last(\"max_daily_streak\") AS \"Best\" FROM \"todoist_stats\""
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Todoist's own streak of days meeting the daily goal, as of the last run; ignores the time picker. Best = longest ever."
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Karma (now)",
      "datasource": {
        "type": "influxdb",
        "uid": "${todoist}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${todoist}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"karma\") FROM \"todoist_stats\""
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "As of the last run; ignores the time picker."
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Lifetime completions",
      "datasource": {
        "type": "influxdb",
        "uid": "${todoist}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${todoist}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"completed_count\") FROM \"todoist_stats\""
        }
      ],
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Todoist's own count since the account was created; ignores the time picker and the project filter."
    },
    {
      "type": "row",
      "id": 8,
      "title": "Rhythm",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Tasks completed per day",
      "datasource": {
        "type": "influxdb",
        "uid": "${todoist}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${todoist}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"n\") FROM (SELECT sum(\"count\") AS \"n\" FROM \"todoist_completion\" WHERE $timeFilter AND \"project\" =~ /^${project:regex}$/ GROUP BY time(1d) fill(0) tz('$tz')) WHERE $timeFilter GROUP BY time($__interval) fill(none) tz('$tz')",
          "alias": "Per day"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "${todoist}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT moving_average(sum(\"count\"), 30) FROM \"todoist_completion\" WHERE time >= ${__from}ms - 30d AND time <= ${__to}ms AND \"project\" =~ /^${project:regex}$/ GROUP BY time(1d) fill(0) tz('$tz')",
          "alias": "30-day average"
        }
      ],
      "interval": "1d",
      "maxDataPoints": 300,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e8e8e"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "pointSize": 4,
            "barAlignment": 0,
            "fillOpacity": 80,
            "gradientMode": "none",
            "spanNulls": false,
            "insertNulls": 1296000000,
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "axisWidth": 60,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Per day"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 45
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "30-day average"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none",
          "hideZeros": false
        }
      },
      "description": "Bars: completions per day, averaged over each bar's span (a day on short ranges, a week or more on long ones). Line: trailing 30-day average."
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Tasks per day, by project",
      "datasource": {
        "type": "influxdb",
        "uid": "${todoist}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${todoist}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"n\") FROM (SELECT sum(\"count\") AS \"n\" FROM \"todoist_completion\" WHERE $timeFilter AND \"project\" =~ /^${project:regex}$/ GROUP BY time(1d), \"project\" fill(0) tz('$tz')) WHERE $timeFilter GROUP BY time($__interval), \"project\" fill(none) tz('$tz')",
          "alias": "$tag_project"
        }
      ],
      "interval": "7d",
      "maxDataPoints": 300,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "pointSize": 4,
            "barAlignment": 0,
            "fillOpacity": 80,
            "gradientMode": "none",
            "spanNulls": false,
            "insertNulls": 1296000000,
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "axisWidth": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "mean",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": true
        }
      },
      "description": "Completions per day, stacked by project, averaged per bar."
    },
    {
      "type": "bargauge",
      "id": 11,
      "title": "Completions by project",
      "datasource": {
        "type": "influxdb",
        "uid": "${todoist}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${todoist}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"count\") FROM \"todoist_completion\" WHERE $timeFilter AND \"project\" =~ /^${project:regex}$/ GROUP BY \"project\"",
          "alias": "$tag_project"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "text",
        "namePlacement": "left",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 24,
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        }
      },
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "description": "Total over the range."
    },
    {
      "type": "row",
      "id": 12,
      "title": "Due dates (one-off tasks)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 13,
      "title": "Done by the due date",
      "datasource": {
        "type": "influxdb",
        "uid": "${todoist}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${todoist}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT count(\"late_days\") FROM \"todoist_task_completed\" WHERE $timeFilter AND \"project\" =~ /^${project:regex}$/ AND \"late_days\" <= 0",
          "hide": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "${todoist}"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT count(\"late_days\") FROM \"todoist_task_completed\" WHERE $timeFilter AND \"project\" =~ /^${project:regex}$/ AND \"late_days\" > -100000",
          "hide": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "$A / $B * 100"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Share of tasks with a due date completed on or before it. Recurring tasks are not in todoist_task_completed, so these are one-off tasks only."
    },
    {
      "type": "stat",
      "id": 14,
      "title": "Done late",
