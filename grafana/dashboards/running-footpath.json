          "uid": "${body}"
        },
        "definition": "SHOW TAG VALUES FROM \"footpath_step\" WITH KEY = \"user\"",
        "query": "SHOW TAG VALUES FROM \"footpath_step\" WITH KEY = \"user\"",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
