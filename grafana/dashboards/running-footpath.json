    {
      "type": "table",
      "title": "The two runs' loops",
      "id": 5,
      "description": "Read on the loops above, per foot: Lift is the loop's highest point; Back swing how far behind the foot travels after push-off, Forward reach how far ahead it swings (both from mid-stance); Sideways its sideways range; Pace and Steps, the pace and the number of steps the loop is the median of.",
      "datasource": {
        "type": "influxdb",
        "uid": "${body}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Lift"
            },
            "properties": [
