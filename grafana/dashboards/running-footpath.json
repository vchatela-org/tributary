      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${body}"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT max(\"z_cm\") AS \"Lift\", min(\"x_cm\") * -1 AS \"Back swing\", max(\"x_cm\") AS \"Forward reach\", spread(\"y_cm\") AS \"Sideways\", 1000 / last(\"speed_mps\") AS \"Pace\", last(\"steps\") AS \"Steps\" FROM \"footpath_loop\" WHERE (\"run\" = '$run' OR \"run\" = '$compare') AND \"user\" = '$user' GROUP BY \"run\", \"side\""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
