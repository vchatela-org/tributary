# Copy to .env and fill in what you use. Every setting is an environment
# variable; nothing here is ever logged or shown by the app.

# The `user` tag on every point (optional).
# TRIBUTARY_INFLUXDB_USER=me

# Time zone of the local_hour / local_weekday fields, and of the schedules.
# TRIBUTARY_TZ=Europe/Paris

# How long an export that was *checked* (a dry run) is kept so "Import for real"
# does not ask for the file again. It holds personal data: past this, the file is
# deleted. Set it in days if you prefer.
# TRIBUTARY_STAGED_UPLOAD_TTL_HOURS=24

# ── Schedules ────────────────────────────────────────────────────────────────
# Each source runs on a 5-field cron expression, in TRIBUTARY_TZ. Set it on the
# source's page instead of here when you can: it needs no redeploy, and the page
# shows the next runs. See docs/scheduling.md.
#
# TRIBUTARY_<KEY>_SCHEDULE="10 3 * * *"      # daily at 03:10
#
# Without one, the connector's own default applies (daily, staggered). The old
# interval setting is deprecated but still honoured, so an existing deployment
# keeps working on upgrade: 15 -> "*/15 * * * *", 120 -> "0 */2 * * *", 1440 -> the
# connector's daily default time. Anything cron cannot say (90, say) falls back to
# the default, with a word about it on the page.
# TRIBUTARY_<KEY>_INTERVAL_MINUTES     (e.g. 1440)

# ── The sources ──────────────────────────────────────────────────────────────

# Audiobookshelf: server URL and an API key (Settings > API Keys).
# TRIBUTARY_ABS_URL=http://audiobookshelf:80
# TRIBUTARY_ABS_TOKEN=
# TRIBUTARY_ABS_SCHEDULE="10 3 * * *"      # daily at 03:10 (its default)
# TRIBUTARY_ABS_LOOKBACK_DAYS=30

# Renpho: one account per person (the app's email and password). Further
# people: TRIBUTARY_RENPHO_EMAIL_2 / _PASSWORD_2 / _USER_2, then _3...
# TRIBUTARY_RENPHO_EMAIL=
# TRIBUTARY_RENPHO_PASSWORD=
# TRIBUTARY_RENPHO_USER=me
# TRIBUTARY_RENPHO_SCHEDULE="52 2 * * *"   # daily at 02:52 (its default)
# Level boundaries per person, from the app's Metric Detail screens (docs/connectors/renpho.md):
# TRIBUTARY_RENPHO_THRESHOLDS={"me": {"bmi": [18.5, 25.0, 30.0]}}

# Todoist: an API token (Settings > Integrations > Developer).
# TRIBUTARY_TODOIST_TOKEN=
# TRIBUTARY_TODOIST_SCHEDULE="30 0 * * *"  # daily at 00:30 (its default)
# TRIBUTARY_TODOIST_LOOKBACK_DAYS=3
# Also write each task's name and labels (free text: off by default).
# TRIBUTARY_TODOIST_TASK_TEXT=false

# MyTherapy: the export ("MyTherapy Archive.zip") you import in the UI, its
# whole history. The mapping is personal: it belongs to your environment.
# TRIBUTARY_MYTHERAPY_NAMES={"<alias>": "<name>"}
# Doses scheduled before this date are not imported (optional, YYYY-MM-DD):
# set it to the day another import's range of the same doses ended, if one
# covered them. Unset: every dose the export holds.
# TRIBUTARY_MYTHERAPY_START_DATE=2024-01-01

# MyFitnessPal: the export (Export Data) you import in the UI. Nothing to set
# but TRIBUTARY_INFLUXDB_USER and TRIBUTARY_INFLUXDB_URL: its weigh-in dedup
# reads the other sources' readings of that user, even for a dry run.

# Medisafe: the dose history export you import in the UI. Optional: rename a
# medication (or leave it out with null), and write each dose's note (free
# text, off by default). The names are personal: they belong to your environment.
# TRIBUTARY_MEDISAFE_NAMES={"<export name>": "<name>", "<another>": null}
# TRIBUTARY_MEDISAFE_NOTES=false
# Doses scheduled after this date are not imported (optional, YYYY-MM-DD): the
# day another app took the doses over.
# TRIBUTARY_MEDISAFE_END_DATE=2026-01-31

# Whoop: your own WHOOP app (developer-dashboard.whoop.com), with the scopes
# offline read:recovery read:cycles read:sleep read:workout, and this redirect
# URI registered exactly. Then "Connect Whoop" on its page. See
# docs/connectors/whoop.md (and its fallback for a plain http:// install).
# TRIBUTARY_WHOOP_CLIENT_ID=
# TRIBUTARY_WHOOP_CLIENT_SECRET=
# TRIBUTARY_WHOOP_REDIRECT_URI=https://tributary.example/connectors/whoop/callback
# TRIBUTARY_WHOOP_SCHEDULE="35 10 * * *"   # daily at 10:35 (its default)
# TRIBUTARY_WHOOP_LOOKBACK_DAYS=7

# The key that encrypts the tokens of a source you connect in the browser
# (Whoop): required to connect one, never a plain-text fallback. Make it with
#   openssl rand -base64 32
# and keep it apart from the data folder. Or TRIBUTARY_SECRET_KEY_FILE, a file
# holding it. While rotating: the old one in TRIBUTARY_SECRET_KEY_PREVIOUS.
# TRIBUTARY_SECRET_KEY=

# ── Compatible tools (not run by Tributary) ──────────────────────────────────

# garmin-grafana: its card shows when its data last arrived, two timestamps read
# from the database it writes, never a value (docs/compatible-tools.md). Empty:
# no line.
# TRIBUTARY_GARMIN_GRAFANA_DATABASE=GarminStats
# Its newest data older than this is marked stale (a warning).
# TRIBUTARY_GARMIN_GRAFANA_STALE_HOURS=24
